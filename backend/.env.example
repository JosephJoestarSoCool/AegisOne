# Backend (FastAPI) configuration. NON-SECRET values only: set these as environment variables on the API host.
# The app does not read a .env file by itself; this file documents the variables.

# Comma-separated list of browser origins allowed to call the API (your deployed frontend). No wildcard.
# Local development default: http://localhost:5173,http://127.0.0.1:5173
AEGIS_CORS_ORIGINS=https://your-frontend.vercel.app

# SQLite file for the deterministic demo data. Default: <repo>/data/aegis.db (built on first start if missing).
# On a host with a persistent disk, point this at it so approvals survive restarts.
# AEGIS_DB=/var/data/aegis.db

# "0" disables POST /api/reset (the demo's Reset button). Default "1".
# AEGIS_ENABLE_RESET=1

# Port is provided by most hosts as PORT; the container honours it (default 8000).
# PORT=8000
