# Backend (FastAPI) configuration. NON-SECRET values only: set these as environment variables on the API host
# (Vercel: Project -> Settings -> Environment Variables). The app does not read a .env file by itself.

# Browser origins allowed to call the API (your deployed frontend). Comma-separated, no wildcard.
# When unset, only the local dev origins http://localhost:5173 and http://127.0.0.1:5173 are allowed.
AEGIS_CORS_ORIGINS=https://your-frontend.vercel.app

# Optional: regex for the frontend's Vercel preview URLs.
# AEGIS_CORS_ORIGIN_REGEX=https://your-frontend-.*\.vercel\.app

# Optional: "0" disables POST /api/reset (the demo's Reset button). Default "1".
# AEGIS_ENABLE_RESET=1

# Optional: SQLite file path. Default: backend/data/aegis.db locally, <tmp>/aegis.db on Vercel (VERCEL=1, set by the platform).
# On serverless this is NOT durable storage (demo limitation, see README).
# AEGIS_DB=/var/data/aegis.db

# Optional: relocate the read-only data directory (processed catalogs + model). Default: backend/data.
# AEGIS_DATA_DIR=/srv/backend/data
