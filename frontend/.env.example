# Frontend (Vite) configuration. VITE_* values are bundled into public JavaScript: NEVER put secrets here.

# Base URL of the deployed FastAPI backend, with no trailing slash.
# Production / Preview: set in the Vercel project (Settings -> Environment Variables).
# Development: leave unset to use the Vite proxy to http://127.0.0.1:8000 (same-origin, no CORS), or set
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=https://your-api.example.com
