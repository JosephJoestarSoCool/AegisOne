# Frontend (Vite) configuration. VITE_* values are bundled into public JavaScript: NEVER put secrets here.
#
# Base URL of the FastAPI backend, no trailing slash.
#   Local development:  http://localhost:8000   (or leave unset: the Vite dev server proxies /api to http://localhost:8000)
#   Vercel production:  set VITE_API_URL in the project's Environment Variables to the deployed API URL,
#                       e.g. https://aegisone-api.vercel.app   (Production and Preview scopes), then redeploy:
#                       Vite inlines it at build time.
VITE_API_URL=http://localhost:8000
